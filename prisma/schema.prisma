generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(cuid())
  name      String?
  email     String     @unique
  createdAt DateTime   @default(now())
  password  String?
  role      Role       @default(EDITOR)
  updatedAt DateTime   @updatedAt
  image     String?
  comments  Comment[]
  pollVotes PollVote[]
  posts     Post[]
  ratings   Rating[]
  sessions  Session[]
  bookmarks Bookmark[]
  productOwnerships ProductOwnership[]
}

model Post {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  content       String
  published     Boolean   @default(false)
  authorId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  featuredImage String?
  views         Int       @default(0)
  tagOrder      String[]  @default([])

  // ── Editorial verdict ──────────────────────────────────────────
  // The reviewer's own score, as opposed to `ratings`, which are readers'.
  // Null on anything that isn't a scored review (news, launch coverage), and
  // every consumer must treat null as "no verdict" rather than zero.
  verdictScore     Float?   // out of 10, one decimal
  verdictSummary   String?  // the bottom line, 1–2 sentences
  verdictSubScores Json     @default("[]") // [{ label: "Camera", score: 8.5 }]

  author        User      @relation(fields: [authorId], references: [id])
  comments      Comment[]
  ratings       Rating[]
  tags          Tag[]     @relation("PostTags")
  bookmarks Bookmark[]

  @@index([views])
  @@index([createdAt])
  @@index([verdictScore])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  icon      String       @default("🏷️")
  colorMode TagColorMode @default(AUTO)
  color     String?      // #rrggbb used when colorMode is CUSTOM (e.g. Android green)
  createdAt DateTime     @default(now())
  posts     Post[]       @relation("PostTags")
  products  Product[]    @relation("ProductTags")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  description String?
  badge       String?  // small tag shown above the headline (e.g. "Top Story")
  cta         String?  // call-to-action button label (e.g. "Read more")
  featuredLabel String? // flag overlaid on the hero image (e.g. "Featured")
  image       String
  link        String
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Ad {
  id        String   @id @default(cuid())
  title     String
  image     String
  link      String
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id         String   @id @default(cuid())
  platform   String
  url        String
  iconSvg    String
  actionText String
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  color      String   @default("#3b82f6")
}

model PopupAd {
  id          String    @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  linkUrl     String?
  linkText    String    @default("Learn More")
  isActive    Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Poll {
  id        String       @id @default(cuid())
  question  String
  isActive  Boolean      @default(true)
  endsAt    DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  options   PollOption[]
  votes     PollVote[]
}

model PollOption {
  id        String     @id @default(cuid())
  pollId    String
  label     String
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     PollVote[]
}

model PollVote {
  id         String     @id @default(cuid())
  pollId     String
  optionId   String
  voterToken String?
  createdAt  DateTime   @default(now())
  userId     String?
  option     PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  poll       Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, voterToken])
  @@unique([pollId, userId])
}

model Rating {
  id         String   @id @default(cuid())
  postId     String
  value      Int
  userId     String?
  voterToken String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@unique([postId, voterToken])
  @@index([postId])
}

model Comment {
  id        String        @id @default(cuid())
  content   String
  postId    String
  authorId  String
  parentId  String?
  status    CommentStatus @default(APPROVED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")

  @@index([postId])
  @@index([parentId])
  @@index([status])
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  ADMIN
  EDITOR
  READER
}

enum OwnershipStatus {
  WANT // "I want it"
  HAVE // "I have it"
  HAD  // "I had it"
}

enum TagColorMode {
  AUTO           // today's heuristic: per-theme correction for near-background colors
  KEEP_ORIGINAL  // never touch colors, in either theme
  FORCE_MONO     // always render as solid currentColor, in both themes
  CUSTOM         // always render as solid Tag.color, in both themes
}

// ─── Gadget Comparison Feature ───────────────────────────────

model GadgetCategory {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  icon      String?
  products  Product[]
  comparisons Comparison[]   // ← add this line
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("gadget_categories")
}

model Product {
  id         String         @id @default(cuid())
  slug       String         @unique   // "iphone-17-pro-max" — used in compare URLs (?p1=slug)
  name       String                    // "iPhone 17 Pro Max"
  brand      String                    // "Apple"
  image      String?                   // primary product photo URL (thumbnail / hero)
  images     String[]      @default([]) // gallery photos (carousel on the product page)
  colors     Json          @default("[]") // color variants: [{ name, hex, image }] — swatches
                                        // on the product page; hovering previews the color's photo.
  priceFrom  Float?                    // starting price, shown under image on compare page
  currency   String         @default("NPR")
  published  Boolean        @default(true)
  tags Tag[] @relation("ProductTags")

  categoryId String
  category   GadgetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  specs      Json                      // category-specific spec values, validated against
                                        // that category's Zod schema (buildSpecsSchema) before write.
                                        // Shape varies per category — flat key/value, e.g.
                                        // { "ram": "12GB", "batteryMah": 5000, "os": "Android" }

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  comparisonsAsA Comparison[] @relation("ComparisonProductA")
  comparisonsAsB Comparison[] @relation("ComparisonProductB")
  productOwnerships ProductOwnership[] 

  @@index([categoryId])
  @@index([slug])
  @@map("products")
}
model Comparison {
  id         String         @id @default(cuid())
  categoryId String
  category   GadgetCategory @relation(fields: [categoryId], references: [id])
  productAId String
  productA   Product        @relation("ComparisonProductA", fields: [productAId], references: [id])
  productBId String
  productB   Product        @relation("ComparisonProductB", fields: [productBId], references: [id])
  active     Boolean        @default(true)
  order      Int            @default(0)
  createdAt  DateTime       @default(now())

  // One-line summary per side, shown above the spec table on /compare. A
  // table states every difference with equal weight; these two lines are what
  // a reader came for. Optional — /compare falls back to a summary derived
  // from the spec deltas when either is null.
  verdictA   String?
  verdictB   String?

  @@index([categoryId])
  @@index([createdAt])
  @@index([order])
  @@map("comparisons")
}

model NewsletterSubscriber {
  id          String    @id @default(cuid())
  email       String    @unique
  token       String    @unique @default(cuid()) // used for confirm & unsubscribe links
  confirmed   Boolean   @default(false)
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

model ProductOwnership {
  id        String          @id @default(cuid())
  userId    String
  productId String
  status    OwnershipStatus
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) // one status per user per product — new pick overwrites old
  @@index([userId])
  @@index([productId])
  @@map("product_ownerships")
}

// Simple key/value store for site-wide toggles/settings managed from the
// dashboard (e.g. the homepage animated-background switch).
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// Spotlight ads — the auto-rotating card beside the homepage gadget category
// section. Supports image/gif (mediaType "image") or video (mediaType "video").
model SpotlightAd {
  id        String   @id @default(cuid())
  title     String
  mediaUrl  String
  mediaType String   @default("image") // "image" | "video"
  link      String
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("spotlight_ads")
}
